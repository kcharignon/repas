# Modèle du fichier /opt/repas/.env (droits 600, jamais dans git). Copier, puis remplacer chaque <…>.
# Générer un secret : openssl rand -hex 32   (hexadécimal : pas de caractère à échapper dans DATABASE_URL)

# Noms de domaine servis par la bordure : APP_HOST = le site (SPA + API), LEGACY_HOST = un ancien nom redirigé vers APP_HOST.
LEGACY_HOST=<app.kantin.eu>
APP_HOST=<kantin.eu>
ACME_EMAIL=<adresse pour les avis Let's Encrypt>

# Versions déployées : écrites par deploy.sh, ne pas éditer à la main.
BACK_TAG=
FRONT_TAG=

# Secrets de l'application.
APP_SECRET=<openssl rand -hex 32>
JWT_PASSPHRASE=<openssl rand -hex 32>
MERCURE_JWT_SECRET=<openssl rand -hex 32>

# Envoi d'emails (confirmation d'adresse, ADR 0020). MAILER_DSN est un secret : l'API HTTPS de Brevo (DigitalOcean bloque le SMTP
# sortant), `brevo+api://<clé d'API>@default`. Recette : `.claude/skills/repas-ops/references/envoi-emails.md`.
# MAILER_FROM : expéditeur, sur un domaine que le service d'envoi a validé (SPF/DKIM), ex. "Repas <no-reply@kantin.eu>".
MAILER_DSN=brevo+api://<clé d'API Brevo, xkeysib-…>@default
MAILER_FROM=<"Repas <no-reply@kantin.eu>">

# Active l'envoi de la liste au drive ; laisser false tant que la fonction n'est pas validée (décision humaine, ADR 0022 et 0023).
# Absente ou false : les routes du drive répondent 404 DRIVE_DISABLED.
DRIVE_ENABLED=false

# Amorçage des ingrédients à l'activation d'un compte (ING-008, ADR 0028) : un compte qui devient actif reçoit une copie des ingrédients
# « de base » du propriétaire du catalogue. Laisser false tant que la passation n'est pas faite (décision humaine) ; écrite par le script
# `ecrire-ingredient-seeding.sh` (skill repas-ops), jamais à la main. Absente ou false : activer un compte ne copie rien.
INGREDIENT_SEEDING_ENABLED=false

# Commande vocale Alexa (ADR 0029, docs/voice/) : « Alexa, demande à mes courses d'ajouter du pain ». Laisser false tant que la fonction n'est
# pas validée (décision humaine, script du skill repas-ops, après un déploiement stable). Absente ou false : le webhook d'Alexa, l'autorisation
# de la liaison de compte et l'échange des jetons répondent 404 VOICE_DISABLED.
ALEXA_ENABLED=false
# Nés dans la console Amazon, écrits ici par un script que l'humain lance, jamais à la main ni dans le chat :
# - identifiant du skill (amzn1.ask.skill.…) : une requête d'un autre skill est refusée ;
# - empreinte du secret du client OAuth, JAMAIS le secret lui-même ;
# - adresses de retour de la liaison de compte (celles de la console Amazon), séparées par des virgules, comparées exactement.
ALEXA_SKILL_ID=
ALEXA_OAUTH_CLIENT_ID=repas-alexa
ALEXA_OAUTH_CLIENT_SECRET_HASH=
ALEXA_REDIRECT_URIS=

# Version de l'application Android (DRV-637) : la dernière publiée (APP_LATEST_VERSION) et la plus ancienne encore attendue
# (APP_MIN_VERSION), trois nombres (`0.1.10`). Vides : personne n'est invité à mettre à jour. Écrites par le script
# `ecrire-app-version.sh` (skill repas-ops) après chaque publication de l'application, jamais à la main.
APP_LATEST_VERSION=
APP_MIN_VERSION=

# Base de données.
POSTGRES_DB=repas
POSTGRES_USER=repas
POSTGRES_PASSWORD=<openssl rand -hex 24>

# Facultatif : reprendre le volume de certificats de l'ancienne installation (évite de redemander les certificats).
# CADDY_DATA_VOLUME=repas_caddy_data
