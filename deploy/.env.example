# Modèle du fichier /opt/repas/.env (droits 600, jamais dans git). Copier, puis remplacer chaque <…>.
# Générer un secret : openssl rand -hex 32   (hexadécimal : pas de caractère à échapper dans DATABASE_URL)

# Noms de domaine servis par la bordure. Marche parallèle : LEGACY_HOST = l'ancien site (Twig), APP_HOST = le nouveau (SPA).
# Bascule : échanger les deux valeurs puis `docker compose up -d edge` (voir .claude/skills/repas-ops).
LEGACY_HOST=<kantin.eu>
APP_HOST=<app.kantin.eu>
ACME_EMAIL=<adresse pour les avis Let's Encrypt>

# Versions déployées : écrites par deploy.sh, ne pas éditer à la main.
BACK_TAG=
FRONT_TAG=

# Secrets de l'application.
APP_SECRET=<openssl rand -hex 32>
JWT_PASSPHRASE=<openssl rand -hex 32>
MERCURE_JWT_SECRET=<openssl rand -hex 32>

# Base de données.
POSTGRES_DB=repas
POSTGRES_USER=repas
POSTGRES_PASSWORD=<openssl rand -hex 24>

# Facultatif : reprendre le volume de certificats de l'ancienne installation (évite de redemander les certificats).
# CADDY_DATA_VOLUME=repas_caddy_data
