# Modèle du fichier /opt/repas/.env (droits 600, jamais dans git). Copier, puis remplacer chaque <…>.
# Générer un secret : openssl rand -hex 32   (hexadécimal : pas de caractère à échapper dans DATABASE_URL)

# Noms de domaine servis par la bordure : APP_HOST = le site (SPA + API), LEGACY_HOST = un ancien nom redirigé vers APP_HOST.
LEGACY_HOST=<app.kantin.eu>
APP_HOST=<kantin.eu>
ACME_EMAIL=<adresse pour les avis Let's Encrypt>

# Versions déployées : écrites par deploy.sh, ne pas éditer à la main.
BACK_TAG=
FRONT_TAG=

# Secrets de l'application.
APP_SECRET=<openssl rand -hex 32>
JWT_PASSPHRASE=<openssl rand -hex 32>
MERCURE_JWT_SECRET=<openssl rand -hex 32>

# Envoi d'emails (confirmation d'adresse, ADR 0020). MAILER_DSN est un secret : l'API HTTPS de Brevo (DigitalOcean bloque le SMTP
# sortant), `brevo+api://<clé d'API>@default`. Recette : `.claude/skills/repas-ops/references/envoi-emails.md`.
# MAILER_FROM : expéditeur, sur un domaine que le service d'envoi a validé (SPF/DKIM), ex. "Repas <no-reply@kantin.eu>".
MAILER_DSN=brevo+api://<clé d'API Brevo, xkeysib-…>@default
MAILER_FROM=<"Repas <no-reply@kantin.eu>">

# Active l'envoi de la liste au drive ; laisser false tant que la fonction n'est pas validée (décision humaine, ADR 0022 et 0023).
# Absente ou false : les routes du drive répondent 404 DRIVE_DISABLED.
DRIVE_ENABLED=false

# Base de données.
POSTGRES_DB=repas
POSTGRES_USER=repas
POSTGRES_PASSWORD=<openssl rand -hex 24>

# Facultatif : reprendre le volume de certificats de l'ancienne installation (évite de redemander les certificats).
# CADDY_DATA_VOLUME=repas_caddy_data
