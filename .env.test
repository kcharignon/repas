# define your env variables for the test env here
KERNEL_CLASS='Repas\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
ADMIN_PASSWORD='test'

POSTGRES_PASSWORD=password
POSTGRES_USER=username
POSTGRES_DB=repas_test
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=16&charset=utf8"

# Fonction « envoyer la liste au drive » allumée en test ; les tests du cas coupé remplacent le service `DriveFeature` par
# `ControlledDriveFeature`. phpunit.dist.xml force aussi la valeur, car la variable injectée par compose (env_file) l'emporte sur ce fichier.
DRIVE_ENABLED=true

# Commande vocale Alexa (ADR 0029) allumée en test ; les tests du cas coupé remplacent le service `VoiceFeature` par `ControlledVoiceFeature`.
# phpunit.dist.xml force aussi la valeur, car la variable injectée par compose (env_file) l'emporte sur ce fichier.
ALEXA_ENABLED=true
# Client OAuth d'Alexa FACTICE (VOX-202) : l'empreinte du secret de tests/Helper/Alexa/AlexaTestClient.php, deux adresses de retour factices.
# phpunit.dist.xml force aussi ces valeurs.
ALEXA_OAUTH_CLIENT_ID=repas-alexa
ALEXA_OAUTH_CLIENT_SECRET_HASH=e5cea9a0b4d40315990eb02d0ae04f5c36c4131aa251d9e0d4e4e731161c9f74
ALEXA_REDIRECT_URIS=https://alexa.example.test/api/skill/link/TESTVENDOR,https://alexa-eu.example.test/api/skill/link/TESTVENDOR

# Connexion avec Google : un ID client FACTICE (jamais un vrai), qu'aucun test n'envoie à Google. phpunit.dist.xml le force aussi.
GOOGLE_CLIENT_ID=123456-repastest.apps.googleusercontent.com
# Le propriétaire du catalogue d'ingrédients des tests : l'adresse de UserBuilder::CATALOG_OWNER_EMAIL (jamais celle du compte protégé)
INGREDIENT_CATALOG_OWNER_EMAIL=catalog-owner@repas.test

# Amorçage des ingrédients à l'activation coupé en test (comme en production par défaut) : les tests qui amorcent allument le double
# `ControlledIngredientSeedingFeature`. phpunit.dist.xml force aussi la valeur, car la variable injectée par compose (env_file) l'emporte sur ce fichier.
INGREDIENT_SEEDING_ENABLED=false
