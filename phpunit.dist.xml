<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <!-- La couverture (Xdebug) garde en mémoire les lignes couvertes par chaque test : à 128 Mo, la suite (3 019 tests) n'avait plus que
             3,5 Mo de marge en CI, et la suivante la dépasse (« Allowed memory size exhausted » au milieu de la suite). -->
        <ini name="memory_limit" value="512M" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <!-- Plus fort que la variable que compose injecte depuis .env (coupée) : voir .env.test -->
        <server name="DRIVE_ENABLED" value="true" force="true" />
        <!-- Commande vocale Alexa allumée en test (ADR 0029), plus forte que la valeur coupée que compose injecte depuis .env : voir .env.test -->
        <server name="ALEXA_ENABLED" value="true" force="true" />
        <!-- ID client Google FACTICE (connexion avec Google allumée en test), plus fort que la valeur vide injectée par compose -->
        <server name="GOOGLE_CLIENT_ID" value="123456-repastest.apps.googleusercontent.com" force="true" />
        <!-- Le propriétaire du catalogue d'ingrédients des tests (UserBuilder::CATALOG_OWNER_EMAIL), plus fort que la valeur vide que compose injecte
             depuis .env (une variable réelle l'emporte sur .env.test) ; jamais l'adresse du compte protégé -->
        <server name="INGREDIENT_CATALOG_OWNER_EMAIL" value="catalog-owner@repas.test" force="true" />
        <!-- L'amorçage des ingrédients à l'activation est COUPÉ en test (ING-008), plus fort que la valeur que compose injecte depuis .env ;
             les tests qui amorcent allument le double ControlledIngredientSeedingFeature -->
        <server name="INGREDIENT_SEEDING_ENABLED" value="false" force="true" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <!-- Données de test, pas de logique : chargées une seule fois hors d'un test (DatabaseTestCase), donc jamais créditées. -->
            <directory>src/Repas/Infrastructure/DataFixture</directory>
            <directory>src/User/Infrastructure/DataFixture</directory>
            <directory>src/Drive/Infrastructure/DataFixture</directory>
        </exclude>
    </source>

    <extensions>
        <!-- Chaque test est exécuté dans une transaction annulée à la fin (voir tests/Helper/DatabaseTestCase.php) -->
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    </extensions>
</phpunit>
