<tr id="user-{{ user.id }}">
    <td>{{ user.email }}</td>
    <td>{{ user.defaultServing }}</td>
    <td>{{ user.recipeCount }}</td>
    <td>{{ user.ingredientCount }}</td>
    <td>{{ user.shoppingListCount }}</td>
    <td>{{ user.createdAt ? user.createdAt|date('Y-m-d') : '' }}</td>
    <td>{{ user.isDisabled ? "inactif" : "actif" }}</td>
    <td>{{ user.isAdmin ? "Administrateur" : "Utilisateur" }}</td>
</tr>
