{% set active = "recipe" %}
{% extends "@Shared/base.html.twig" %}

{% block title %}
    Recette : {{ recipe.name }}
{% endblock %}

{% block body %}
    <h1>{{ recipe.name|capitalize }}</h1>
    <div class="row">
        <div class="col-lg-4">
            <ul class="list-group">
                <li class="list-group-item active" aria-current="true">Ingrédients pour {{ recipe.serving }} personnes</li>
                {% for row in recipe.rows %}
                    <li class="list-group-item d-flex align-item-center" style="height: 42px">
                        <span class="me-1">
                                {{ row.quantity ~ row.unitSymbol }}
                            {% if row.unitSymbol != "" %}de{% endif %}
                            </span>
                        <strong>{{ row.ingredientName|capitalize }}</strong>
                        <span class="flex-fill"></span>
                        {% if row.ingredientImage|length > 0 %}
                        <img
                            class="align-self-center"
                            style="height: 32px"
                            src="{{ absolute_url(asset(row.ingredientImage)) }}"
                            alt="{{ row.ingredientName }}">
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
