# Niveau 5 au départ (ADR 0011) ; monter à 6, 7, 8 quand la baseline est vidée.
# Tout code nouveau doit passer sans nouvelle entrée de baseline.
includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 5
    paths:
        - src/
        - tests/
        - quality-rules/Phpstan/
    treatPhpDocTypesAsCertain: false
    # La migration-garde d'ING-014, la migration des conversions universelles, celles des votes de rayons, celle des index et celle des comptes en attente sont chargées par un test (les migrations ne sont pas autoloadées)
    scanFiles:
        - migrations/Version20261024120000.php
        - migrations/Version20261027100000.php
        - migrations/Version20261027150000.php
        - migrations/Version20261027180000.php
        - migrations/Version20261027180100.php
        - migrations/Version20261027200000.php
        - migrations/Version20261028120000.php

services:
    -
        class: PHPStanRules\EnsureControllerAndHandlerHaveTestRule
        arguments:
            testDirectories:
                - %currentWorkingDirectory%/tests
        tags:
            - phpstan.rules.rule
