# Niveau 5 au départ (ADR 0011) ; monter à 6, 7, 8 quand la baseline est vidée.
# Tout code nouveau doit passer sans nouvelle entrée de baseline.
includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 5
    paths:
        - src/
        - tests/
        - quality-rules/Phpstan/
    treatPhpDocTypesAsCertain: false
    # La migration-garde d'ING-014, la migration des conversions universelles, celles des votes de rayons, celle des index, celle des comptes en attente, celle des majuscules des noms et celle des valeurs observées par les comptes du drive, celle de la largeur des identifiants de magasin, celle de l'identifiant d'offre et celle de la préférence d'enseigne, celle de l'icône d'un rayon, celle de la recette secrète, celle des recettes favorites, celle des types de liste de courses et celle de la répartition d'un repas éclaté sont chargées par un test (les migrations ne sont pas autoloadées)
    scanFiles:
        - migrations/Version20261024120000.php
        - migrations/Version20261027100000.php
        - migrations/Version20261027150000.php
        - migrations/Version20261027180000.php
        - migrations/Version20261027180100.php
        - migrations/Version20261027200000.php
        - migrations/Version20261028120000.php
        - migrations/Version20261028160000.php
        - migrations/Version20261029100000.php
        - migrations/Version20261030100000.php
        - migrations/Version20261030140000.php
        - migrations/Version20261030170000.php
        - migrations/Version20261030190000.php
        - migrations/Version20261030210000.php
        - migrations/Version20261031100000.php
        - migrations/Version20261031120000.php
        - migrations/Version20261031160000.php

services:
    -
        class: PHPStanRules\EnsureControllerAndHandlerHaveTestRule
        arguments:
            testDirectories:
                - %currentWorkingDirectory%/tests
        tags:
            - phpstan.rules.rule
